    ],
    "execute": [
      {
        "description": "create table \"accountToken\"",
        "sql": "CREATE TABLE \"public\".\"accountToken\" (\n  \"consumedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"tokenHash\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"userId\" int4 NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"accountToken_type_check_ac18db37\" CHECK (\"type\" IN ('PASSWORD_RESET', 'EMAIL_VERIFICATION'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"accountToken\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"accountToken\""
        ]
      }
    ]
  },
