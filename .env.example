# Required application settings
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Required: restricted runtime role used by the application only.
# Keep TLS parameters out of URLs; TLS is controlled by DATABASE_TLS_* below.
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/myapp"
# Optional admin/migration role for Prisma CLI; falls back to DATABASE_URL locally.
DATABASE_MIGRATION_URL=""

# Local PostgreSQL may use disable. Production requires verify-full.
DATABASE_TLS_MODE=disable
# Optional PEM CA bundle for private/self-signed database CAs.
DATABASE_TLS_CA_FILE=""
# Prisma CLI needs this before Node starts; set it in your shell/deploy platform.
# cmd.exe: set NODE_EXTRA_CA_CERTS=H:\\\\path\\\\database-ca.pem
# PowerShell: $env:NODE_EXTRA_CA_CERTS = "H:\\\\path\\\\database-ca.pem"
NODE_EXTRA_CA_CERTS=""
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Required: replace with independent random values of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-random-access-secret-32-chars-minimum"
JWT_REFRESH_SECRET="replace-with-a-different-refresh-secret-32-chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=express-ts-starter
JWT_ACCESS_AUDIENCE=express-ts-starter-api
JWT_REFRESH_AUDIENCE=express-ts-starter-refresh
CORS_ORIGINS="http://localhost:3000"
CORS_CREDENTIALS=true
# Optional; defaults to CORS_ORIGINS. Exact origins only, never *.
CSRF_TRUSTED_ORIGINS=""
# false, true, hop count (for example 1), or an Express proxy subnet/name.
# Production must not use true; use an exact hop count or trusted network.
TRUST_PROXY=false
COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=""
COOKIE_PATH=/api/v1/auth

# In-memory by default. Set redis in multi-instance deployments.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_PREFIX=express-ts-starter:rate-limit:
# Required only when RATE_LIMIT_STORE=redis. Use rediss:// when your provider requires TLS.
REDIS_URL=""
REDIS_CONNECT_TIMEOUT_MS=10000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW=1h
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW=1m
RATE_LIMIT_FORGOT_PASSWORD_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=1h

# Central refresh-session policy. rememberMe selects the persistent idle TTL.
SESSION_IDLE_TTL=24h
SESSION_REMEMBER_ME_IDLE_TTL=7d
SESSION_ABSOLUTE_TTL=30d
SESSION_REVOKED_RETENTION=30d

# Optional SMTP module; fields may be blank while disabled.
SMTP_ENABLED=false
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Optional Cloudinary module; fields may be blank while disabled.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
