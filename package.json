{
  "name": "express-ts-starter",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:database": "vitest run tests/integration/refresh-rotation.database.test.ts tests/integration/session-lifecycle.database.test.ts tests/integration/authorization.database.test.ts",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "config:check": "tsx src/config/check.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "sessions:cleanup": "tsx src/scripts/cleanup-sessions.ts",
    "db:emit": "npx prisma contract emit",
    "db:format": "npx prisma contract format",
    "db:verify": "npx prisma db verify",
    "db:status": "npx prisma migration status",
    "db:plan": "npx prisma migration plan",
    "db:migrate": "npx prisma db migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "qs": "6.16.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prisma": "8.0.0-rc.13",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
